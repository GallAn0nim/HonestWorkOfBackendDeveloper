{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "https_port": 443,
  "RateLimiting": {
    "General": {
      "PermitLimit": 500,
      "WindowSeconds": 60
    },
    "Auth": {
      "PermitLimit": 75,
      "WindowSeconds": 60
    },
    "Heavy": {
      "PermitLimit": 150,
      "WindowSeconds": 60
    },
    "LogStreamConnections": 4
  },
  "Kestrel": {
    "Limits": {
      "MaxRequestBodySize": 4096
    }
  },
  "Sorting": {
    "MaxItems": 32,
    "SmallestValue": 10,
    "LargestValue": 89,
    "DefaultCount": 12,
    "MaxSteps": 5000
  },
  "Maze": {
    "Width": 30,
    "Height": 30,
    "AdditionalPassagesPercent": 15,
    "DrunkMouseMaxMoves": 9000,
    "WallHuggerMaxMoves": 3600
  },
  "Cache": {
    "ActivateAtRps": 4,
    "EntrySeconds": 30,
    "SessionIdleSeconds": 120,
    "MaxSessions": 200,
    "MaxConcurrentQueries": 4,
    "QueryTimeoutSeconds": 5
  },
  "Race": {
    "Customers": 20,
    "MaxConcurrentRaces": 2,
    "MaxPendingQueues": 50,
    "PendingQueueSeconds": 60,
    "TimeoutSeconds": 5
  },
  "Observability": {
    "LogHistorySize": 500,
    "LogFollowerBacklog": 250,
    "LogMaxPageSize": 100,
    "MetricSampleCapacity": 50000,
    "CurrentRpsSeconds": 5,
    "ChartPoints": 60,
    "TraceRunCapacity": 10
  },
  "Cv": {
    "DefaultLanguage": "en",
    "Page": {
      "WidthMm": 210,
      "HeightMm": 297,
      "Margin": 34,
      "FontSize": 10
    },
    "Labels": {
      "en": {
        "Skills": "Skills",
        "Experience": "Experience",
        "Education": "Education",
        "Languages": "Languages",
        "Thesis": "Thesis",
        "Technologies": "Tech",
        "Present": "present"
      }
    }
  }
}
